{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noEmitOnError": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "jsx": "react",
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "@core/*": ["./src/core/*"],
      "@core/shared/*": ["./src/core/shared/*"],
      "@core/runtime/*": ["./src/core/runtime/*"],
      "@core/adapters/*": ["./src/core/adapters/*"],
      "@core/skills/*": ["./src/skills/*"],
      "@config/*": ["./src/config/*"],
      "@providers/*": ["./src/providers/*"],
      "@ui/*": ["./src/ui/*"],
      "@tui/*": ["./src/tui/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/test-*.ts",
    "test/**/*.ts"
  ]
}
