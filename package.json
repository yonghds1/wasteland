{
  "name": "rxc",
  "version": "0.1.0",
  "description": "An RxJS-first TypeScript agent CLI scaffold.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "rxc": "./bin/rxc.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm test",
    "cli": "tsx src/cli.ts chat",
    "cli:build": "npm run build && node ./bin/rxc.js chat",
    "tui": "tsx src/cli.ts tui",
    "tui:build": "npm run build && node ./bin/rxc.js tui"
  },
  "keywords": [
    "cli",
    "commander",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
