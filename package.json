{
  "name": "wasteland",
  "version": "0.1.0",
  "description": "Wasteland CLI - A multi-agent CLI with Immortan Joe as the main character",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "wasteland": "./bin/wasteland.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json && cp -r src/locales/*.json dist/locales/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run validate:i18n && npm test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,json}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json}'",
    "validate:i18n": "node scripts/validate-i18n.js",
    "dev": "tsx src/cli.ts",
    "tui": "tsx src/cli.ts tui",
    "tui:build": "npm run build && node ./bin/wasteland.js tui",
    "postinstall": "npm run build && ./scripts/create-aliases.sh",
    "aliases": "./scripts/create-aliases.sh",
    "aliases:switch": "./scripts/create-aliases.sh"
  },
  "keywords": [
    "cli",
    "commander",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@alcyone-labs/zod-to-json-schema": "^4.0.10",
    "cheerio": "^1.2.0",
    "commander": "^14.0.2",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "rxjs": "^7.8.2",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
