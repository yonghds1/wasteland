{
  "name": "wasteland",
  "version": "0.1.0",
  "description": "Wasteland CLI - A multi-agent CLI with Immortan Joe as the main character",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "wasteland": "./bin/wasteland.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json && cp -r src/locales/*.json dist/locales/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --experimental-test-isolation=none test/**/*.test.js",
    "check": "npm run typecheck && npm run validate:i18n && npm test",
    "validate:i18n": "node scripts/validate-i18n.js",
    "cli": "tsx src/cli.ts chat",
    "cli:build": "npm run build && node ./bin/wasteland.js chat",
    "tui": "tsx src/cli.ts tui",
    "tui:build": "npm run build && node ./bin/wasteland.js tui",
    "postinstall": "npm run build && ./scripts/create-aliases.sh",
    "aliases": "./scripts/create-aliases.sh",
    "aliases:switch": "./scripts/create-aliases.sh"
  },
  "keywords": [
    "cli",
    "commander",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "ink": "^7.0.3",
    "react": "^19.2.6",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
